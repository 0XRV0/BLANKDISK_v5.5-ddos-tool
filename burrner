def ip_to_region(ip: str) -> tuple:
    """Fake-but-stable region label from IP for display."""
    try:
        first = int(ip.split(".")[0])
    except Exception:
        return ("UNK", "Unknown")
    for lo, hi, code, city in REGION_BUCKETS:
        if lo <= first <= hi:
            # slight variation so same /8 isn't always one city
            city = CITY_POOL[(first + int(ip.split(".")[-1])) % len(CITY_POOL)]
            return (code, city)
    return ("UNK", "Unknown")

def resolve_target_label(target: str) -> tuple:
    """Return (ip, region_code, city) for display."""
    host = target.replace("http://", "").replace("https://", "").split("/")[0].split(":")[0]
    try:
        ip = socket.gethostbyname(host)
    except Exception:
        ip = host
    code, city = ip_to_region(ip) if ip.replace(".", "").isdigit() else ("DST", host[:20])
    return (ip, code, city)

