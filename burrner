# ======================== SAFETY LAYER ========================
class SafetyGuard:
    """Hard block on local machine, LAN, router, and all private/reserved ranges."""

    PRIVATE_RANGES = [
        ipaddress.ip_network("0.0.0.0/8"),
        ipaddress.ip_network("10.0.0.0/8"),
        ipaddress.ip_network("100.64.0.0/10"),      # CGNAT
        ipaddress.ip_network("127.0.0.0/8"),
        ipaddress.ip_network("169.254.0.0/16"),
        ipaddress.ip_network("172.16.0.0/12"),
        ipaddress.ip_network("192.0.0.0/24"),
        ipaddress.ip_network("192.0.2.0/24"),        # TEST-NET
        ipaddress.ip_network("192.168.0.0/16"),
        ipaddress.ip_network("198.18.0.0/15"),
        ipaddress.ip_network("198.51.100.0/24"),
        ipaddress.ip_network("203.0.113.0/24"),
        ipaddress.ip_network("224.0.0.0/4"),         # multicast
        ipaddress.ip_network("240.0.0.0/4"),         # reserved
        ipaddress.ip_network("255.255.255.255/32"),
        ipaddress.ip_network("::1/128"),
        ipaddress.ip_network("fc00::/7"),
        ipaddress.ip_network("fe80::/10"),
        ipaddress.ip_network("ff00::/8"),
    ]

    BLOCKED_HOSTNAMES = {
        "localhost", "localhost.localdomain", "ip6-localhost", "ip6-loopback",
        "0.0.0.0", "broadcasthost", "::1",
    }

    def __init__(self):
        self.local_ips = set()
        self.gateway_ips = set()
        self._detect_local()
        self._detect_gateways()

    def _detect_local(self):
        """Collect every IP that belongs to this machine."""
        self.local_ips.add("127.0.0.1")
        self.local_ips.add("::1")
        # Primary outbound interface
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("8.8.8.8", 80))
            self.local_ips.add(s.getsockname()[0])
            s.close()
        except Exception:
            pass
        # Hostname resolution
        try:
            hostname = socket.gethostname()
            self.local_ips.add(socket.gethostbyname(hostname))
            for info in socket.getaddrinfo(hostname, None):
                ip = info[4][0]
                self.local_ips.add(ip)
        except Exception:
            pass
        # All interface addresses (best-effort)
        try:
            import netifaces  # optional
            for iface in netifaces.interfaces():
                addrs = netifaces.ifaddresses(iface)
                for family in (netifaces.AF_INET, netifaces.AF_INET6):
                    if family in addrs:
                        for a in addrs[family]:
                            if "addr" in a:
                                self.local_ips.add(a["addr"].split("%")[0])
        except Exception:
            pass

    def _detect_gateways(self):
        """Guess common router / gateway addresses and add them to the kill list."""
        # Standard home-router defaults
        common = [
            "192.168.0.1", "192.168.1.1", "192.168.1.254", "192.168.0.254",
            "192.168.2.1", "10.0.0.1", "10.1.1.1", "172.16.0.1",
            "192.168.100.1", "192.168.8.1", "192.168.9.1",
        ]
        self.gateway_ips.update(common)
        # Derive gateway from our own LAN IP (x.x.x.1)
        for ip in list(self.local_ips):
            try:
                parts = ip.split(".")
                if len(parts) == 4 and not ip.startswith("127."):
                    self.gateway_ips.add(".".join(parts[:3] + ["1"]))
                    self.gateway_ips.add(".".join(parts[:3] + ["254"]))
            except Exception:
                pass
        # Try netifaces gateways
        try:
            import netifaces
            gws = netifaces.gateways()
            default = gws.get("default", {})
            for family in (netifaces.AF_INET, netifaces.AF_INET6):
                if family in default:
                    self.gateway_ips.add(default[family][0])
        except Exception:
            pass

    def _parse_host(self, target: str) -> str:
        """Strip scheme, path, port → bare hostname/IP."""
        t = target.strip().lower()
        t = t.replace("https://", "").replace("http://", "").replace("ftp://", "")
        t = t.split("/")[0]          # drop path
        t = t.split("?")[0]          # drop query
        # handle [ipv6]:port
        if t.startswith("["):
            end = t.find("]")
            if end != -1:
                return t[1:end]
        # host:port
        if t.count(":") == 1:
            t = t.split(":")[0]
        return t.strip()

    def _ip_is_blocked(self, ip_str: str) -> bool:
        if ip_str in self.local_ips or ip_str in self.gateway_ips:
            return True
        try:
            ip = ipaddress.ip_address(ip_str)
            if ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_reserved or ip.is_unspecified:
                return True
            for net in self.PRIVATE_RANGES:
                if ip in net:
                    return True
            return False
        except ValueError:
            return False

    def is_safe(self, target: str) -> bool:
        """
        Return True ONLY if target is a public, non-local address.
        Blocks: localhost, LAN, router/gateway, CGNAT, multicast, reserved.
        """
        host = self._parse_host(target)
        if not host:
            return False

        # Hostname blacklist
        if host in self.BLOCKED_HOSTNAMES:
            return False
        if host in self.local_ips or host in self.gateway_ips:
            return False

        # Direct IP?
        try:
            if self._ip_is_blocked(host):
                return False
            return True
        except Exception:
            pass

        # Hostname → resolve ALL addresses and reject if any is local/private
        try:
            infos = socket.getaddrinfo(host, None)
            if not infos:
                return False
            for info in infos:
                ip = info[4][0]
                if self._ip_is_blocked(ip):
                    return False
            return True
        except socket.gaierror:
            # Unresolvable — treat as unsafe (fail closed)
            return False
        except Exception:
            return False

    def status_report(self) -> str:
        lines = [
            f"  Local IPs     : {sorted(self.local_ips) or ['(none detected)']}",
            f"  Gateways      : {sorted(self.gateway_ips) or ['(none)']}",
            f"  Private nets  : 10/8, 172.16/12, 192.168/16, 127/8, CGNAT, link-local, multicast",
            f"  Policy        : FAIL-CLOSED — unresolved / private / local = BLOCKED",
        ]
        return "\n".join(lines)

# ======================== PROXY MANAGER ========================
class ProxyPool:
    def __init__(self):
        self.proxies: List[str] = []
        self.working: List[str] = []
        self.lock = threading.Lock()
        self.last_refresh = 0

    def _pull_one(self, url: str) -> set:
        """Fetch a single source with hard timeout. Returns set of proxies."""
        got = set()
        try:
            req = urllib.request.Request(
                url,
                headers={"User-Agent": random.choice(USER_AGENTS)},
            )
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = resp.read().decode("utf-8", errors="ignore")
            for line in data.splitlines():
                line = line.strip()
                if ":" not in line or line.startswith("#"):
                    continue
                parts = line.split(":")
                if len(parts) == 2 and parts[1].isdigit():
                    got.add(line)
        except Exception:
            pass
        return got

    def fetch(self) -> int:
        print(f"{C.Y}[*] Fetching open proxies from {len(PROXY_SOURCES)} sources...{C.END}")
        found = set()
        done = 0
        total = len(PROXY_SOURCES)

        def job(url):
            return self._pull_one(url)

        # parallel pull — max 6 workers, each source max 5s
        with ThreadPoolExecutor(max_workers=6) as ex:
            futures = {ex.submit(job, url): url for url in PROXY_SOURCES}
            for fut in futures:
                url = futures[fut]
                short = url.split("/")[2] if "://" in url else url[:32]
                try:
                    chunk = fut.result(timeout=6)
                    found.update(chunk)
                    done += 1
                    print(f"  {C.G}✓{C.END} {C.STEEL}{short:<28}{C.END} +{len(chunk):,}  ({done}/{total})")
                except Exception:
                    done += 1
                    print(f"  {C.R}✗{C.END} {C.ASH}{short:<28}{C.END} timeout/fail  ({done}/{total})")

        with self.lock:
            self.proxies = list(found)
            self.last_refresh = time.time()

        if self.proxies:
            print(f"{C.G}[+] Loaded {len(self.proxies):,} proxies{C.END}")
        else:
            print(f"{C.Y}[!] No proxies loaded — L7 will run direct (still safety-locked){C.END}")
        return len(self.proxies)

    def get_random(self) -> Optional[str]:
        with self.lock:
            pool = self.working if self.working else self.proxies
            if not pool:
                return None
            return random.choice(pool)

    def mark_good(self, proxy: str):
        with self.lock:
            if proxy not in self.working:
                self.working.append(proxy)

    def mark_bad(self, proxy: str):
        with self.lock:
            if proxy in self.working:
                self.working.remove(proxy)
            if proxy in self.proxies:
                self.proxies.remove(proxy)

