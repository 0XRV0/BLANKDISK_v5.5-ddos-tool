def live_stats(methods: Methods, duration: int):
    """Full tactical display: globe route, proxy origins, target, live counters."""
    start = time.time()
    tip, tcode, tcity = methods.target_label
    frame = 0
    while methods.running and (time.time() - start) < duration + 1:
        elapsed = max(0.01, time.time() - methods.stats["start"])
        sent = methods.stats["sent"]
        ok = methods.stats["success"]
        fail = methods.stats["fail"]
        rps = sent / elapsed
        bar_len = 40
        progress = min(1.0, elapsed / duration) if duration else 0
        filled = int(bar_len * progress)
        bar = ""
        for j in range(bar_len):
            if j < filled:
                if j < bar_len * 0.25:
                    bar += f"{C.BLOOD}█"
                elif j < bar_len * 0.55:
                    bar += f"{C.FIRE1}█"
                elif j < bar_len * 0.80:
                    bar += f"{C.FIRE2}█"
                else:
                    bar += f"{C.FIRE3}█"
            else:
                bar += f"{C.ASH}░"
        bar += C.END

        # recent proxy origins
        with methods._lock:
            recent = list(methods.recent_proxies[-8:])
        if recent:
            # pick a "current" source city for the globe line
            src_city = recent[-1].split("|")[0]
        else:
            src_city = "Proxy Legion"

        clear()
        print(f"{C.FIRE1}{C.BOLD}  ▌ LIVE VECTOR  —  {methods.stats.get('method', 'ATTACK')}{C.END}")
        print(draw_globe_route(src_city, tcity or tip or "TARGET", frame))
        frame += 1

        print(f"  {C.ASH}TARGET{C.END}  {C.W}{tip or '—'}{C.END}  {C.FIRE3}→{C.END} {C.NEON}{tcode}{C.END} / {C.STEEL}{tcity}{C.END}")
        print(f"  {C.ASH}ROUTE {C.END}  {C.STEEL}{src_city}{C.END} {C.FIRE3}━━━▶{C.END} {C.W}{tcity or tip}{C.END}")
        print()
        print(f"  {C.ASH}[{bar}]{C.END} {C.FIRE4}{int(progress*100):3d}%{C.END}  {C.STEEL}{elapsed:.0f}s / {duration}s{C.END}")
        print()
        print(f"  {C.G}SENT{C.END} {sent:>10,}    {C.B}OK{C.END} {ok:>10,}    {C.R}FAIL{C.END} {fail:>8,}    {C.Y}RPS{C.END} {rps:>8.0f}")
        print()
        print(f"  {C.ASH}┌─ PROXY ORIGINS (recent) ──────────────────────────────────┐{C.END}")
        if recent:
            # show as city chips
            chips = []
            for ent in recent:
                city, ip = (ent.split("|") + [""])[:2]
                chips.append(f"{C.NEON}{city}{C.END}{C.ASH}@{ip}{C.END}")
            # 2 per line
            for i in range(0, len(chips), 2):
                row = "   ".join(chips[i:i+2])
                print(f"  {C.ASH}│{C.END} {row}")
        else:
            print(f"  {C.ASH}│{C.END} {C.STEEL}awaiting first hop...{C.END}")
        print(f"  {C.ASH}└───────────────────────────────────────────────────────────┘{C.END}")
        print(f"\n  {C.DIM}Ctrl+C will not stop mid-burst — wait for duration or close terminal{C.END}")

        time.sleep(0.35)
    print()

