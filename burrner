def draw_globe_route(src_city: str, dst_city: str, frame_idx: int = 0) -> str:
    """ASCII globe + arc line from source region toward target."""
    g = GLOBE_FRAMES[frame_idx % 2]
    # simple arc drawn under the globe
    arc_len = 36
    pos = int((time.time() * 8) % arc_len)
    arc = list("·" * arc_len)
    for k in range(max(0, pos - 2), min(arc_len, pos + 3)):
        arc[k] = "═" if k == pos else ("─" if abs(k - pos) == 1 else "·")
    arc_str = "".join(arc)

    lines = [
        f"{C.ASH}{'─' * 62}{C.END}",
        f"  {C.NEON}SRC{C.END} {C.STEEL}{src_city:<14}{C.END}  {C.FIRE3}━━━╗{C.END}",
    ]
    for row in g:
        lines.append(f"  {C.ASH}{row}{C.END}")
    lines.append(f"  {C.ASH}          {arc_str}{C.END}")
    lines.append(f"  {C.FIRE3}              ┗━━━{C.END}  {C.FIRE1}DST{C.END} {C.W}{dst_city}{C.END}")
    lines.append(f"{C.ASH}{'─' * 62}{C.END}")
    return "\n".join(lines)

