                d=int(input(f"  {C.Y}Duration [60]:{C.END} ") or 60); c=int(input(f"  {C.Y}Threads [100]:{C.END} ") or 100)
                self.run_attack("L6-MIX", m.l6_flood, t, p, d, c, "mix")
            elif choice=="90":
